{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "agenthub-desktop",
  "outputfilename": "desktop",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "postBuildHooks": {
    "darwin/*": "../bundle-binaries.sh ${platform} ${bin}",
    "linux/*": "../bundle-binaries.sh ${platform} ${bin}",
    "windows/*": "bash ../bundle-binaries.sh ${platform} ${bin}"
  },
  "author": {
    "name": "SheldonChang",
    "email": "SheldonChangL@users.noreply.github.com"
  }
}
